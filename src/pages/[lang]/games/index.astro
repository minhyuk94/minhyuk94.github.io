---
import Base from '../../../layouts/Base.astro';
import data from '../../../data/resume.json';
import { LANGS, list, text, tr, url, type Lang, type Resume } from '../../../lib/resume';
import { LANG_LABEL, ui } from '../../../lib/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const r = data as Resume;
const t = ui[lang];
const games = r.games ?? [];
---

<Base
  title={`${t.galleryTitle} | ${tr(r.profile.name, lang)}`}
  description={t.galleryLead}
  lang={lang}
  image={games.find((g) => g.gallery?.length)?.gallery?.[0].image ?? r.profile.photo}
  alternates={LANGS.map((l) => ({ lang: l, href: url(`/${l}/games/`) }))}
>
  <header class="gal-top">
    <a class="gal-back" href={url(`/${lang}/#games`)}>← {t.back}</a>
    <div class="gal-langs">
      {LANGS.map((l) => <a href={url(`/${l}/games/`)} class:list={{ on: l === lang }} lang={l}>{LANG_LABEL[l]}</a>)}
    </div>
  </header>
  <main class="gal">
    <h1>{t.galleryTitle}</h1>
    <p class="gal-lead">{t.galleryLead}</p>
    {
      games.map((g) => (
        <section class="gal-game">
          <h2>
            <span aria-hidden="true">{g.icon}</span> {text(g.name, lang)}
          </h2>
          <p class="gal-sum">{tr(g.summary, lang)}</p>
          {g.gallery?.length ? (
            <div class="gal-grid">
              {g.gallery.map((s) => (
                <figure>
                  <a href={url(s.image)} target="_blank" rel="noopener">
                    <img src={url(s.image)} alt={tr(s.caption, lang)} loading="lazy" />
                  </a>
                  <figcaption>{tr(s.caption, lang)}</figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <p class="gal-empty">{t.galleryEmpty}</p>
          )}
          <ul class="gal-tags">
            {list(g.tags).map((tag) => <li>{tag}</li>)}
          </ul>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .gal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 24px;
  }
  .gal-back {
    font-weight: 700;
    text-decoration: none;
  }
  .gal-langs {
    display: flex;
    gap: 10px;
  }
  .gal-langs a {
    text-decoration: none;
    opacity: 0.6;
  }
  .gal-langs a.on {
    opacity: 1;
    font-weight: 700;
  }
  .gal {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 64px;
  }
  .gal h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 12px 0 6px;
  }
  .gal-lead {
    opacity: 0.75;
    margin: 0 0 32px;
  }
  .gal-game {
    margin: 0 0 48px;
  }
  .gal-game h2 {
    font-size: 24px;
    margin: 0 0 6px;
  }
  .gal-sum {
    margin: 0 0 16px;
    opacity: 0.85;
  }
  .gal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .gal-grid figure {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(127, 127, 127, 0.08);
    border: 1px solid rgba(127, 127, 127, 0.18);
  }
  .gal-grid img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    image-rendering: pixelated;
    transition: transform 0.25s;
  }
  .gal-grid a:hover img {
    transform: scale(1.03);
  }
  .gal-grid figcaption {
    padding: 10px 12px;
    font-size: 14px;
    opacity: 0.85;
  }
  .gal-empty {
    padding: 28px;
    text-align: center;
    border: 1px dashed rgba(127, 127, 127, 0.4);
    border-radius: 12px;
    opacity: 0.7;
  }
  .gal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
  }
  .gal-tags li {
    font-size: 12px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(127, 127, 127, 0.14);
  }
</style>
