---
import '../styles/global.css';
import { url } from '../lib/resume';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** 다른 언어 버전 주소 (검색엔진에 알려줌) */
  alternates?: { lang: string; href: string }[];
  noindex?: boolean;
  image?: string;
}

const { title, description, lang, alternates = [], noindex = false, image } = Astro.props;
// 방문 통계 (Google Analytics: 방문 수·화면만, 광고 기능 끔). 편집 페이지(noindex)·자동 시험 브라우저·로컬에서는 켜지 않음
const GA = "(function(){var id='G-KK27YSJPEJ';if(navigator.webdriver||!/\\.github\\.io$/.test(location.hostname))return;window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',id,{allow_google_signals:false,allow_ad_personalization_signals:false});var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+id;document.head.appendChild(s)})();";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(url(image), Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0b0f1a" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {!noindex && <script is:inline set:html={GA} />}
  </head>
  <body>
    <slot />
  </body>
</html>
