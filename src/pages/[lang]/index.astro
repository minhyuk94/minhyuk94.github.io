---
import Base from '../../layouts/Base.astro';
import Resume from '../../components/Resume.astro';
import data from '../../data/resume.json';
import { LANGS, tr, type Lang, type Resume as ResumeData } from '../../lib/resume';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const r = data as ResumeData;
const title = `${tr(r.profile.name, lang)} | ${tr(r.profile.role, lang)}`;
const description = tr(r.profile.tagline, lang);
---

<Base
  title={title}
  description={description}
  lang={lang}
  image={r.profile.photo}
  alternates={[...LANGS.map((l) => ({ lang: l, href: `/${l}/` })), { lang: 'x-default', href: '/' }]}
>
  <Resume lang={lang} />
</Base>
